{$DOMAIN} {
	encode zstd gzip

	# Uploaded photos are content-addressed, so they can be cached hard.
	@media path /api/media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Published sites are meant to be opened from a WhatsApp message,
		# so HSTS only after the domain is settled. Uncomment then:
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy app:3000

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
