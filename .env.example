# Copie para .env.local (dev) ou .env (Docker) e preencha.
# lib/env.ts valida isto no boot — deploy mal configurado quebra na subida,
# não na primeira venda.

# Origem pública, sem barra no final. Vira os links compartilhados e as
# URLs de retorno/webhook do Mercado Pago.
APP_URL=http://localhost:3000

# Ambos vivem no volume ./data em produção.
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# --- Mercado Pago ---------------------------------------------------------
# Credenciais em: mercadopago.com.br/developers > suas integrações > credenciais
# Token de teste começa com TEST-. Sem ele o checkout se recusa a rodar.
MP_ACCESS_TOKEN=
# Segredo do webhook (painel > webhooks > "assinatura secreta"). Sem ele
# qualquer um pode POSTar "pagamento aprovado" pra gente.
MP_WEBHOOK_SECRET=

# --- E-mail ---------------------------------------------------------------
# smtp://usuario:senha@host:587  — é como o link chega no cliente.
SMTP_URL=
MAIL_FROM=Happyday <nao-responda@seudominio.com.br>

# --- Admin ----------------------------------------------------------------
# Mínimo 16 caracteres. Ausente = painel fechado.
ADMIN_TOKEN=
